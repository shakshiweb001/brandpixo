# Create an access key at https://web3forms.com and place it in your private .env file.
# For Vercel, add this variable in Project Settings > Environment Variables.
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# --- Analytics & ads tracking (all optional; nothing loads when a value is empty) ---
# Recommended: set only the GTM ID and add GA4 / Meta Pixel / Google Ads tags inside Google Tag Manager.
VITE_GTM_ID=GTM-XXXXXXX
# Only used when VITE_GTM_ID is NOT set (otherwise you would count everything twice):
VITE_GA4_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=your_meta_pixel_id
